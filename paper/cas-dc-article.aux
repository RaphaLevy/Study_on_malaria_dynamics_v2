\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Normalized sensitivity index $S_x = \partial \log Y/\partial \log x$ of each decomposed parameter, evaluated at the reference state of Section~\ref {sec:sensitivity}. The $\mathcal  {R}_0$ column is the exact analytic index; the $Q_{\mathrm  {peak}}$ column is the central-difference estimate ($h = 0.05$) of the calibrated model averaged over 2017-2023 ($Q_{\mathrm  {peak}} = 1{,}033$). Parameters are grouped by mechanism as in Section~\ref {sec:sensitivity}. A dash denotes a parameter that is structurally absent from the closed form. The population size $N$ is listed apart from the groups because it is not a free parameter of the calibration.}}{13}{table.caption.8}\protected@file@percent }
\newlabel{tbl:index}{{3}{13}{Normalized sensitivity index $S_x = \partial \log Y/\partial \log x$ of each decomposed parameter, evaluated at the reference state of Section~\ref {sec:sensitivity}. The $\mathcal {R}_0$ column is the exact analytic index; the $Q_{\mathrm {peak}}$ column is the central-difference estimate ($h = 0.05$) of the calibrated model averaged over 2017-2023 ($Q_{\mathrm {peak}} = 1{,}033$). Parameters are grouped by mechanism as in Section~\ref {sec:sensitivity}. A dash denotes a parameter that is structurally absent from the closed form. The population size $N$ is listed apart from the groups because it is not a free parameter of the calibration}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces First-order ($S_1$, dark bars) and total-order ($S_T$, pale bars) Sobol' indices of the 25 decomposed parameters with respect to the seasonal peak $Q_{\mathrm  {peak}}$ of the infectious-human compartment, over the whole admissible parameter box of Table~\ref {tbl:box} (Saltelli design, $N = 512$; bars coloured by parameter group). The total-order index also collects the variance that a parameter carries through its interactions with the remaining ones, hence $S_T \geq S_1$. Since $Q_{\mathrm  {peak}}$ is a maximum, the $74.4\%$ of the sampled parameter sets that are locally subcritical leave it at the initial value $I_H(0)$; the indices therefore characterize the sampled box and not the height of an established endemic wave.}}{13}{figure.caption.10}\protected@file@percent }
\newlabel{FIG:sobol_ih}{{6}{13}{First-order ($S_1$, dark bars) and total-order ($S_T$, pale bars) Sobol' indices of the 25 decomposed parameters with respect to the seasonal peak $Q_{\mathrm {peak}}$ of the infectious-human compartment, over the whole admissible parameter box of Table~\ref {tbl:box} (Saltelli design, $N = 512$; bars coloured by parameter group). The total-order index also collects the variance that a parameter carries through its interactions with the remaining ones, hence $S_T \geq S_1$. Since $Q_{\mathrm {peak}}$ is a maximum, the $74.4\%$ of the sampled parameter sets that are locally subcritical leave it at the initial value $I_H(0)$; the indices therefore characterize the sampled box and not the height of an established endemic wave}{figure.caption.10}{}}
