\@writefile{lof}{\contentsline {figure}{\numberline {1A}{\ignorespaces DDE simulation of the baseline SIR-SEI model using the original parameterization from \cite  {Parham2010}. The dynamics of the SIR model show a monotonic decline in the number of infected individuals within the human population, indicating the absence of sustained transmission, while the dynamics of the SEI model show that the entire mosquito population tends to extinction, an unexpected behavior for a region where malaria is highly endemic.}}{22}{figure.9}\protected@file@percent }
\newlabel{FIG:1A}{{1A}{22}{DDE simulation of the baseline SIR-SEI model using the original parameterization from \cite {Parham2010}. The dynamics of the SIR model show a monotonic decline in the number of infected individuals within the human population, indicating the absence of sustained transmission, while the dynamics of the SEI model show that the entire mosquito population tends to extinction, an unexpected behavior for a region where malaria is highly endemic}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2A}{\ignorespaces ODE simulation of the baseline SIR model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite  {Parham2010}. A slight increase in the infectious population can be noticed, although it still tends to extinction over the course of the first year of transmission.}}{22}{figure.10}\protected@file@percent }
\newlabel{FIG:2A}{{2A}{22}{ODE simulation of the baseline SIR model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite {Parham2010}. A slight increase in the infectious population can be noticed, although it still tends to extinction over the course of the first year of transmission}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3A}{\ignorespaces ODE simulation of the baseline SEI mosquito model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite  {Parham2010}. It can be seen that the mosquito population still tends to extinction.}}{22}{figure.11}\protected@file@percent }
\newlabel{FIG:3A}{{3A}{22}{ODE simulation of the baseline SEI mosquito model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite {Parham2010}. It can be seen that the mosquito population still tends to extinction}{figure.11}{}}
