\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Normalized sensitivity index $S_x = \partial \log Y/\partial \log x$ of the 25 decomposed parameters (bars coloured by parameter group, as in Table~\ref {tbl:index}). Left: closed-form reproduction number at the reference environmental state, by central differences with $h = 0.05$; the exact analytic values of Table~\ref {tbl:index} differ from these by at most $0.06$, the truncation error of the difference quotient. Right: seasonal maximum of the infectious-human compartment of the calibrated model, averaged over 2017-2023, same scheme. A positive index means the output increases with the parameter. The three \textit  {Anopheles} suitability temperatures are exactly zero on the left because the thermal-suitability factor $f_T$ is saturated at the reference climate.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{FIG:local_sensitivity}{{5}{12}{Normalized sensitivity index $S_x = \partial \log Y/\partial \log x$ of the 25 decomposed parameters (bars coloured by parameter group, as in Table~\ref {tbl:index}). Left: closed-form reproduction number at the reference environmental state, by central differences with $h = 0.05$; the exact analytic values of Table~\ref {tbl:index} differ from these by at most $0.06$, the truncation error of the difference quotient. Right: seasonal maximum of the infectious-human compartment of the calibrated model, averaged over 2017-2023, same scheme. A positive index means the output increases with the parameter. The three \textit {Anopheles} suitability temperatures are exactly zero on the left because the thermal-suitability factor $f_T$ is saturated at the reference climate}{figure.caption.9}{}}
