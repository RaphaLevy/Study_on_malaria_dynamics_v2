\@writefile{lof}{\contentsline {figure}{\numberline {1A}{\ignorespaces Simulation of the baseline SIR model using the original parameterization from \cite  {Parham2010}. The dynamics show a monotonic decline in the number of infected individuals, indicating the absence of sustained transmission.}}{11}{figure.2}\protected@file@percent }
\newlabel{FIG:1A}{{1A}{11}{Simulation of the baseline SIR model using the original parameterization from \cite {Parham2010}. The dynamics show a monotonic decline in the number of infected individuals, indicating the absence of sustained transmission}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2A}{\ignorespaces Simulation of the baseline SEI mosquito model using the original parameterization from \cite  {Parham2010}. The susceptible mosquito population exhibits oscillatory behavior and attains negative values, indicating a loss of biological and mathematical consistency.}}{11}{figure.3}\protected@file@percent }
\newlabel{FIG:2A}{{2A}{11}{Simulation of the baseline SEI mosquito model using the original parameterization from \cite {Parham2010}. The susceptible mosquito population exhibits oscillatory behavior and attains negative values, indicating a loss of biological and mathematical consistency}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3A}{\ignorespaces Simulation of the SEI mosquito model after modifying parameter functions to enforce biologically admissible bounds on probabilities and rates. Although positivity is restored, the mosquito population rapidly declines toward extinction, suggesting that additional mechanisms are required to sustain endemic transmission.}}{11}{figure.4}\protected@file@percent }
\newlabel{FIG:3A}{{3A}{11}{Simulation of the SEI mosquito model after modifying parameter functions to enforce biologically admissible bounds on probabilities and rates. Although positivity is restored, the mosquito population rapidly declines toward extinction, suggesting that additional mechanisms are required to sustain endemic transmission}{figure.4}{}}
