\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}Figures}{14}{subsection.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1A}{\ignorespaces DDE simulation of the baseline SIR model using the original parameterization from Parham $\&$ Michael (2010) \cite  {Parham2010}. The dynamics show a monotonic decline in the number of infected individuals, indicating the absence of sustained transmission.}}{14}{figure.1}\protected@file@percent }
\newlabel{FIG:1A}{{1A}{14}{DDE simulation of the baseline SIR model using the original parameterization from Parham $\&$ Michael (2010) \cite {Parham2010}. The dynamics show a monotonic decline in the number of infected individuals, indicating the absence of sustained transmission}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2A}{\ignorespaces DDE simulation of the baseline SEI mosquito model using the original parameterization from \cite  {Parham2010}. The dynamics show that the entire population tended to extinction, an unexpected behavior for a region where malaria is highly endemic.}}{14}{figure.2}\protected@file@percent }
\newlabel{FIG:2A}{{2A}{14}{DDE simulation of the baseline SEI mosquito model using the original parameterization from \cite {Parham2010}. The dynamics show that the entire population tended to extinction, an unexpected behavior for a region where malaria is highly endemic}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3A}{\ignorespaces ODE simulation of the baseline SIR model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite  {Parham2010}. A slight increase in the infectious population can be noticed, although it still tends to extinction over the course of the first year of transmission.}}{14}{figure.3}\protected@file@percent }
\newlabel{FIG:3A}{{3A}{14}{ODE simulation of the baseline SIR model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite {Parham2010}. A slight increase in the infectious population can be noticed, although it still tends to extinction over the course of the first year of transmission}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4A}{\ignorespaces ODE simulation of the baseline SEI mosquito model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite  {Parham2010}. It can be seen that the mosquito population still tends to extinction.}}{14}{figure.4}\protected@file@percent }
\newlabel{FIG:4A}{{4A}{14}{ODE simulation of the baseline SEI mosquito model using the formulation from Section~\ref {sec:ode_approximation_limitations} and parameters from \cite {Parham2010}. It can be seen that the mosquito population still tends to extinction}{figure.4}{}}
